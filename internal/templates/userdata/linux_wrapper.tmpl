#!/bin/bash

set -e
set -o pipefail

CALLBACK_URL="{{ .CallbackURL }}"
METADATA_URL="{{ .MetadataURL }}"
BEARER_TOKEN="{{ .CallbackToken }}"
{{- if .HTTPProxy }}
export HTTP_PROXY='{{ .HTTPProxy }}'
export http_proxy='{{ .HTTPProxy }}'
{{- end }}
{{- if .HTTPSProxy }}
export HTTPS_PROXY='{{ .HTTPSProxy }}'
export https_proxy='{{ .HTTPSProxy }}'
{{- end }}
{{- if .NoProxy }}
export NO_PROXY='{{ .NoProxy }}'
export no_proxy='{{ .NoProxy }}'
{{- end }}

LOCK_DIR="/tmp/garm-runner-bootstrap.lock"
DONE_FILE="/tmp/garm-runner-bootstrap.done"
CALLBACK_ENV_FILE="/run/garm/callback.env"

# Hand the callback credentials to services that outlive this bootstrap. The
# Spot preemption watchdog is why: its notice arrives long after the wrapper has
# exited, on a machine that is seconds from disappearing, and reporting it is
# the only chance GARM has to start the replacement before the retry is queued.
# Root-only, on tmpfs, so it dies with the VM.
#
# Written through a unique temporary file because this wrapper can run twice at
# once — that is what the lock below exists for — and never fatal: a runner that
# cannot persist them simply does not report preemptions, which is not worth
# failing a bootstrap over.
function persist_callback_env() {
	local tmp
	mkdir -p "$(dirname "$CALLBACK_ENV_FILE")" || return 1
	# mktemp creates at 0600, and its unique name is what makes two wrappers
	# racing here safe.
	tmp="$(mktemp "${CALLBACK_ENV_FILE}.XXXXXX")" || return 1
	if printf 'CALLBACK_URL=%s\nBEARER_TOKEN=%s\n' "$CALLBACK_URL" "$BEARER_TOKEN" > "$tmp" && mv -f "$tmp" "$CALLBACK_ENV_FILE"; then
		return 0
	fi
	rm -f "$tmp"
	return 1
}

persist_callback_env || echo "failed to persist callback credentials; this runner cannot report a preemption notice"

function call() {
	PAYLOAD="$1"
	[[ $CALLBACK_URL =~ ^(.*)/status(/)?$ ]] || CALLBACK_URL="${CALLBACK_URL}/status"
	curl --retry 5 --retry-delay 5 --retry-connrefused --fail -s -X POST -d "${PAYLOAD}" -H 'Accept: application/json' -H "Authorization: Bearer ${BEARER_TOKEN}" "${CALLBACK_URL}" || echo "failed to call home: exit code ($?)"
}

function fail() {
	MSG="$1"
	call "{\"status\": \"failed\", \"message\": \"$MSG\"}"
	exit 1
}

LOCK_ACQUIRED=false
for _ in {1..300}; do
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		LOCK_ACQUIRED=true
		break
	fi
	if [[ -e "$DONE_FILE" ]]; then
		exit 0
	fi
	sleep 1
done
if [[ "$LOCK_ACQUIRED" != true ]]; then
	fail "timed out waiting for the runner bootstrap lock"
fi
trap 'rmdir "$LOCK_DIR"' EXIT
if [[ -e "$DONE_FILE" ]]; then
	exit 0
fi

HTTP_CODE=$(curl -H "Authorization: Bearer $BEARER_TOKEN" --retry 5 --retry-delay 5 --retry-connrefused -s -w "%{http_code}" -o /tmp/real-install.sh "$METADATA_URL/install-script/" || echo "000")
if [ "$HTTP_CODE" != "200" ]; then
	BODY=$(cat /tmp/real-install.sh 2>/dev/null || true)
	rm -f /tmp/real-install.sh
	ERR=$(printf '%s' "$BODY" | sed -n 's/.*"details":"\(.*\)"}[[:space:]]*$/\1/p')
	[ -n "$ERR" ] || ERR=$(printf '%s' "$BODY" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')
	fail "failed to fetch install script (HTTP ${HTTP_CODE}): ${ERR}"
fi

chmod +x /tmp/real-install.sh
/tmp/real-install.sh
touch "$DONE_FILE"
rm -f /tmp/real-install.sh
